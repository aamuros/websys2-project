APP_NAME="Community Garden"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local Supabase PostgreSQL started by `supabase start`.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54322
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer
DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_CONNECTION=pgsql
SESSION_TABLE=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reserved for a future backend-only Supabase Storage integration.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_STORAGE_BUCKET=community-garden-uploads
SUPABASE_SERVICE_ROLE_KEY=

VITE_APP_NAME="${APP_NAME}"
